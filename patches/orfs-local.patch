diff --git a/flow/scripts/cts.tcl b/flow/scripts/cts.tcl
index 18ebf9c3dd56a9ecb2cf55c30ad8c06085332ca4..17affd4a060bcb8f35694f5c18659798788a8437 100644
--- a/flow/scripts/cts.tcl
+++ b/flow/scripts/cts.tcl
@@ -46,7 +46,18 @@ set_placement_padding -global \
   -left $::env(CELL_PAD_IN_SITES_DETAIL_PLACEMENT) \
   -right $::env(CELL_PAD_IN_SITES_DETAIL_PLACEMENT)
 
-set result [catch { detailed_placement_helper } msg]
+set dpl_args {}
+# LOCAL PATCH (aichip 2026-07-11): expose -max_displacement for the post-CTS
+# legalization. Macro-dominated asap7 aichip_l2 inserts ~3.4k hold buffers at
+# macro input pins; rsz drops them at wire midpoints (often on macros/halo)
+# and the stock displacement limit leaves ~37 cells unplaceable (DPL-0036).
+# Unset -> no arg -> stock behavior.
+# Ported 2026-09-29 (pin 49416916f): upstream dropped dpl_args and sends every
+# legalization through detailed_placement_helper { args }; passing the arg to the
+# two CTS calls below keeps it CTS-only, as before (DETAIL_PLACEMENT_ARGS would also
+# apply it to placement and global route).
+append_env_var dpl_args DPL_MAX_DISPLACEMENT -max_displacement 1
+set result [catch { detailed_placement_helper {*}$dpl_args } msg]
 if { $result != 0 } {
   save_progress 4_1_error
   error "Detailed placement failed in CTS: $msg"
@@ -71,7 +82,7 @@ if { !$::env(SKIP_CTS_REPAIR_TIMING) } {
     run_lec_test 4_rsz 4_before_rsz_lec.v 4_after_rsz_lec.v
   }
 
-  set result [catch { detailed_placement_helper } msg]
+  set result [catch { detailed_placement_helper {*}$dpl_args } msg]
   if { $result != 0 } {
     save_progress 4_1_error
     error "Detailed placement failed in CTS: $msg"
